-- Universal Player Spoof --

if type(getgenv) ~= "function" then
    error("此 executor 不支援 getgenv")
end

local cfg = getgenv().Config
if type(cfg) ~= "table" then
    error("找不到 getgenv().Config,請先設定 config")
end

local victim   = cfg.victim
local helper   = cfg.helper or ""
local level    = tonumber(cfg.level)  or 0
local streak   = tonumber(cfg.streak) or 0
local elo      = tonumber(cfg.elo)    or 0
local premium  = cfg.premium
local verified = cfg.verified
local platform = cfg.platform and tostring(cfg.platform):upper() or nil

if not victim then error("Config.victim 未設定") end

repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")

local target = (helper ~= "")
    and Players:WaitForChild(helper)
    or Players.LocalPlayer

-- 抓 victim 資料 --
local function fetchUser(id)
    if type(game.HttpGet) == "function" then
        return game:HttpGet("https://users.roblox.com/v1/users/" .. tostring(id), true)
    end
    local rq = (syn and syn.request) or http_request or request or (http and http.request)
    if rq then
        local res = rq({ Url = "https://users.roblox.com/v1/users/" .. tostring(id), Method = "GET" })
        return res.Body or res.body
    end
    error("此 executor 沒有 HttpGet 或 request")
end

local decodedData = HttpService:JSONDecode(fetchUser(victim))

-- 改身分 --
target.Name = decodedData.name
target.UserId = decodedData.id
target.CharacterAppearanceId = decodedData.id
target.DisplayName = decodedData.displayName

repeat task.wait() until target.Character
target.Character:WaitForChild("Humanoid")
target.Character.Name = decodedData.name
target.Character.Humanoid.DisplayName = decodedData.displayName

local spoofedPlayer = Players:WaitForChild(decodedData.name)

-- 通用等級/連勝/ELO 屬性 (遊戲有讀就會生效,沒讀也無害) --
if level  > 0 then spoofedPlayer:SetAttribute("Level", level)  end
if streak > 0 then spoofedPlayer:SetAttribute("StatisticDuelsWinStreak", streak) end
if streak > 0 then spoofedPlayer:SetAttribute("WinStreak", streak) end     -- 常見別名
if elo    > 0 then spoofedPlayer:SetAttribute("DisplayELO", elo) end
if elo    > 0 then spoofedPlayer:SetAttribute("ELO", elo) end               -- 常見別名

-- 若遊戲有 CustomLeaderstats 這種結構就順便寫進去 --
pcall(function()
    local lb = spoofedPlayer:FindFirstChild("CustomLeaderstats") or spoofedPlayer:FindFirstChild("leaderstats")
    if lb then
        if lb:FindFirstChild("Level")     and level  > 0 then lb.Level.Value = level end
        if lb:FindFirstChild("Win Streak") and streak > 0 then lb["Win Streak"].Value = streak end
        if lb:FindFirstChild("WinStreak")  and streak > 0 then lb.WinStreak.Value = streak end
        if lb:FindFirstChild("ELO")        and elo    > 0 then lb.ELO.Value = elo end
    end
end)

-- 套 victim 外觀 (以 HumanoidDescription 為主) --
local function applyAppearance()
    local plr = Players:FindFirstChild(decodedData.name)
    if not plr or not plr.Character then return end
    local char = plr.Character
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    -- 主方法:HumanoidDescription (臉、身體、頭型、膚色、衣服、配件全包) --
    local descOk = pcall(function()
        local desc = Players:GetHumanoidDescriptionFromUserId(decodedData.id)
        humanoid:ApplyDescription(desc)
    end)

    -- 備用:如果 ApplyDescription 失敗,手動用 GetCharacterAppearanceAsync --
    if not descOk then
        local ok, appearance = pcall(function()
            return Players:GetCharacterAppearanceAsync(decodedData.id)
        end)
        if not ok or not appearance then return end

        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants")
               or v:IsA("BodyColors") or v:IsA("CharacterMesh") or v:IsA("ShirtGraphic") then
                v:Destroy()
            end
        end
        local head = char:FindFirstChild("Head")
        if head then
            for _, v in ipairs(head:GetChildren()) do
                if v:IsA("Decal") or v:IsA("SpecialMesh") then
                    v:Destroy()
                end
            end
        end
        for _, v in ipairs(appearance:GetChildren()) do
            if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic")
               or v:IsA("BodyColors") or v:IsA("CharacterMesh") then
                v.Parent = char
            elseif v:IsA("Accessory") then
                pcall(function() humanoid:AddAccessory(v) end)
            elseif v:IsA("Decal") and head then
                v.Parent = head
            elseif (v:IsA("SpecialMesh") or v:IsA("DataModelMesh")) and head then
                v.Parent = head
            end
        end
    end

    -- 強制重繪 --
    local parent = char.Parent
    char.Parent = nil
    char.Parent = parent
end
applyAppearance()
spoofedPlayer.CharacterAdded:Connect(function()
    task.wait(0.2)
    applyAppearance()
end)

-- Metatable hook:Premium / 驗證徽章 / 平台 --
if type(hookmetamethod) == "function" then
    -- 平台 → UserInputService 屬性對照 --
    local platformProps = {
        DESKTOP = { KeyboardEnabled = true,  MouseEnabled = true,  TouchEnabled = false, GamepadEnabled = false, VREnabled = false },
        MOBILE  = { KeyboardEnabled = false, MouseEnabled = false, TouchEnabled = true,  GamepadEnabled = false, VREnabled = false },
        CONSOLE = { KeyboardEnabled = false, MouseEnabled = false, TouchEnabled = false, GamepadEnabled = true,  VREnabled = false },
        VR      = { KeyboardEnabled = false, MouseEnabled = false, TouchEnabled = false, GamepadEnabled = false, VREnabled = true  },
    }
    local platformOverrides = platform and platformProps[platform] or nil

    local oldNamecall
    oldNamecall = hookmetamethod(game, "__index", function(self, key)
        if self == spoofedPlayer then
            if key == "MembershipType" and premium then
                return Enum.MembershipType.Premium
            end
            if key == "HasVerifiedBadge" and verified then
                return true
            end
        end
        if platformOverrides and self == UserInputService and platformOverrides[key] ~= nil then
            return platformOverrides[key]
        end
        return oldNamecall(self, key)
    end)
else
    if premium or verified or platform then
        warn("[Spoof] 此 executor 不支援 hookmetamethod,無法偽造 Premium/驗證/平台")
    end
end
