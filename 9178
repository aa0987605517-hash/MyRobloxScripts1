-- ============================================
-- Roblox Rivals 修改 (近戰冷卻移除)
-- ============================================
local rivalsModEnabled = false
local rivalsItems = nil
local originalValues = {}  -- 儲存原始數值以便還原

local function applyRivalsMod()
    if not rivalsModEnabled then return end
    
    if game.GameId == 6035872082 or game.PlaceId == 17618583907 then
        local Storage = game:GetService("ReplicatedStorage")
        local itemLibrary = Storage:FindFirstChild("Modules")
        if itemLibrary then
            rivalsItems = require(itemLibrary.ItemLibrary).Items
            
            for name, data in pairs(rivalsItems) do
                if typeof(data) == "table" then
                    -- 儲存原始數值
                    if not originalValues[name] then
                        originalValues[name] = {}
                    end
                    
                    -- === 近戰恢復時間移除 ===
                    if data.AttackCooldown then 
                        originalValues[name].AttackCooldown = data.AttackCooldown
                        data.AttackCooldown = 0.001 
                    end
                    if data.SwingCooldown then 
                        originalValues[name].SwingCooldown = data.SwingCooldown
                        data.SwingCooldown = 0.001 
                    end
                    if data.MeleeCooldown then 
                        originalValues[name].MeleeCooldown = data.MeleeCooldown
                        data.MeleeCooldown = 0.001 
                    end
                    if data.RecoveryTime then 
                        originalValues[name].RecoveryTime = data.RecoveryTime
                        data.RecoveryTime = 0.001 
                    end
                    
                    -- === 投擲物即時投擲 ===
                    if data.ThrowCooldown then 
                        originalValues[name].ThrowCooldown = data.ThrowCooldown
                        data.ThrowCooldown = 0.001 
                    end
                    if data.ActivationDelay then 
                        originalValues[name].ActivationDelay = data.ActivationDelay
                        data.ActivationDelay = 0.001 
                    end
                    if data.EquipDelay then 
                        originalValues[name].EquipDelay = data.EquipDelay
                        data.EquipDelay = 0.001 
                    end
                    if data.Cooldown then 
                        originalValues[name].Cooldown = data.Cooldown
                        data.Cooldown = 0.001 
                    end
                end
            end
            print("✅ Rivals 修改已套用")
        end
    end
end

local function removeRivalsMod()
    if not rivalsItems then return end
    
    for name, data in pairs(rivalsItems) do
        if typeof(data) == "table" and originalValues[name] then
            if originalValues[name].AttackCooldown then data.AttackCooldown = originalValues[name].AttackCooldown end
            if originalValues[name].SwingCooldown then data.SwingCooldown = originalValues[name].SwingCooldown end
            if originalValues[name].MeleeCooldown then data.MeleeCooldown = originalValues[name].MeleeCooldown end
            if originalValues[name].RecoveryTime then data.RecoveryTime = originalValues[name].RecoveryTime end
            if originalValues[name].ThrowCooldown then data.ThrowCooldown = originalValues[name].ThrowCooldown end
            if originalValues[name].ActivationDelay then data.ActivationDelay = originalValues[name].ActivationDelay end
            if originalValues[name].EquipDelay then data.EquipDelay = originalValues[name].EquipDelay end
            if originalValues[name].Cooldown then data.Cooldown = originalValues[name].Cooldown end
        end
    end
    originalValues = {}
    print("✅ Rivals 修改已移除")
end

