-- ===== 黏人邏輯 =====
local stickEnabled = false
local targetPlayer = nil
local stickConnection = nil
local stickLastPos = nil

local function getPlayerList()
    local list = {}
    for _, p in pairs(game:GetService("Players"):GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(list, p)
        end
    end
    return list
end

local function selectNextTarget()
    local players = getPlayerList()
    if #players == 0 then
        targetName.Text = "無"
        targetPlayer = nil
        statusLabel.Text = "沒有可黏的玩家"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    local found = false
    for i, p in pairs(players) do
        if targetPlayer == p then
            if i < #players then
                targetPlayer = players[i + 1]
            else
                targetPlayer = players[1]
            end
            found = true
            break
        end
    end
    
    if not found then
        targetPlayer = players[1]
    end
    
    targetName.Text = targetPlayer.Name
    statusLabel.Text = "目標: " .. targetPlayer.Name
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
end

local function startStick()
    if stickConnection then
        stickConnection:Disconnect()
        stickConnection = nil
    end
    
    stickConnection = RunService.Heartbeat:Connect(function()
        if not stickEnabled or not targetPlayer then return end
        
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local targetChar = targetPlayer.Character
        local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        
        if hrp and targetHrp then
            hrp.CFrame = targetHrp.CFrame
        end
    end)
end

