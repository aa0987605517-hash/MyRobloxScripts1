            Size = UDim2.new(0, 200, 0, 350)
        }):Play()
        task.wait(0.2)
        mainFrame.Visible = false
        toggleFloat.Text = "Toggle UI"
        toggleFloat.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
