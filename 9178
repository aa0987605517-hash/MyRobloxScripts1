local function updateToggle(toggle, dot, enabled, color)
    if enabled then
        TweenService:Create(toggle, TweenInfo.new(0.3), {BackgroundColor3 = color}):Play()
        TweenService:Create(dot, TweenInfo.new(0.3), {Position = UDim2.new(0.52, 0, 0.5, -9)}):Play()
        TweenService:Create(dot, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    else
        TweenService:Create(toggle, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(30, 30, 30)}):Play()
        TweenService:Create(dot, TweenInfo.new(0.3), {Position = UDim2.new(0.04, 0, 0.5, -9)}):Play()
        TweenService:Create(dot, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(150, 150, 150)}):Play()
    end
end

