-- ===== 熱鍵 =====
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.V then
        flyBtn.MouseButton1Click:Fire()
    elseif input.KeyCode == Enum.KeyCode.B then
        stickBtn.MouseButton1Click:Fire()
    elseif input.KeyCode == Enum.KeyCode.R then
        rivalsBtn.MouseButton1Click:Fire()
    elseif input.KeyCode == Enum.KeyCode.T then
        teleBtn.MouseButton1Click:Fire()
    elseif input.KeyCode == Enum.KeyCode.X then
        toggleFloat.MouseButton1Click:Fire()
    elseif input.KeyCode == Enum.KeyCode.L then
        lockFloat.MouseButton1Click:Fire()
    elseif input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.R then
        if stickEnabled then
            selectBtn.MouseButton1Click:Fire()
        end
    end
end)

-- ===== 角色重生 =====
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = character:WaitForChild("Humanoid")
    
    if flyEnabled then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then lastPos = hrp.CFrame end
    end
    
    if stickEnabled then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            stickLastPos = hrp.CFrame
        end
        if stickConnection then
            stickConnection:Disconnect()
            stickConnection = nil
        end
        startStick()
    end
end)

-- ===== 玩家離開時清理 =====
game:GetService("Players").PlayerRemoving:Connect(function(p)
    if targetPlayer == p then
        targetPlayer = nil
        targetName.Text = "無"
        if stickEnabled then
            selectNextTarget()
            if stickConnection then
                stickConnection:Disconnect()
                stickConnection = nil
            end
            startStick()
        end
    end
end)

