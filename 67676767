		--
		local function encodeVal(v)
			if typeof(v) == "Color3" then
				return {__c3 = true, r = v.R, g = v.G, b = v.B}
			elseif typeof(v) == "table" then
				local o = {}
				for k, vv in pairs(v) do o[k] = encodeVal(vv) end
				return o
			elseif typeof(v) == "number" or typeof(v) == "string" or typeof(v) == "boolean" then
				return v
			end
			return nil
		end
		local function decodeVal(v, into)
			if typeof(v) == "table" then
				if v.__c3 then return Color3.new(v.r, v.g, v.b) end
				if typeof(into) == "table" then
					for k, vv in pairs(v) do into[k] = decodeVal(vv, into[k]) end
					return into
				end
				local o = {}; for k, vv in pairs(v) do o[k] = decodeVal(vv) end; return o
			end
			return v
		end
