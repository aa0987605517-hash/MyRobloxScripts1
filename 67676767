		local function loadCfg()
			if not readfile or not isfile or not isfile(FILE) then return end
			local ok, data = pcall(function() return HttpService:JSONDecode(readfile(FILE)) end)
			if not ok then return end
			for k, t in pairs(library.__state) do
				if data[k] then decodeVal(data[k], t) end
			end
		end
