		utility:CreateConnection(RunService.RenderStepped, function()
			Camera = workspace.CurrentCamera
			for plr, o in pairs(ESP.Objects) do
				local ok = false
				repeat
					if not ESP.Enabled then break end
					local char = plr.Character
					if not char then break end
					local hrp = char:FindFirstChild("HumanoidRootPart")
					local hum = char:FindFirstChildOfClass("Humanoid")
					local head = char:FindFirstChild("Head")
					if not (hrp and hum and head) or hum.Health <= 0 then break end
					if not ESP.Teammates and LP.Team and plr.Team == LP.Team then break end
					if _G.PW_BLOCK and _G.PW_BLOCK[plr.Name] then break end
					--
					local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
					if dist > ESP.MaxDist then break end
					--
					local hipH = (hum.HipHeight or 0)
					local topWorld = (head and head.Position or hrp.Position) + Vector3.new(0, (head and head.Size.Y/2 or 0.5) + 0.5, 0)
					local botWorld = hrp.Position - Vector3.new(0, hrp.Size.Y/2 + hipH + 1, 0)
					local topSP = Camera:WorldToViewportPoint(topWorld)
					local botSP = Camera:WorldToViewportPoint(botWorld)
					if topSP.Z <= 0 and botSP.Z <= 0 then break end
					local h = math.abs(topSP.Y - botSP.Y)
					if h < 4 then break end
					local w = h * 0.55
					local cx = (topSP.X + botSP.X) / 2
					local y = math.min(topSP.Y, botSP.Y)
					local x = cx - w / 2
					--
					if ESP.Box and not ESP.CornerBox then
						o.BoxOutline.Size = Vector2.new(w, h); o.BoxOutline.Position = Vector2.new(x, y); o.BoxOutline.Visible = true
						o.Box.Size = Vector2.new(w, h); o.Box.Position = Vector2.new(x, y); o.Box.Color = ESP.Colors.Box; o.Box.Visible = true
					else
						o.BoxOutline.Visible = false; o.Box.Visible = false
					end
					if ESP.CornerBox then
						local L = math.min(w, h) * 0.25
						local pts = {
							{Vector2.new(x, y),       Vector2.new(x+L, y)},       {Vector2.new(x, y),       Vector2.new(x, y+L)},
							{Vector2.new(x+w, y),     Vector2.new(x+w-L, y)},     {Vector2.new(x+w, y),     Vector2.new(x+w, y+L)},
							{Vector2.new(x, y+h),     Vector2.new(x+L, y+h)},     {Vector2.new(x, y+h),     Vector2.new(x, y+h-L)},
							{Vector2.new(x+w, y+h),   Vector2.new(x+w-L, y+h)},   {Vector2.new(x+w, y+h),   Vector2.new(x+w, y+h-L)}
						}
						for i, p in ipairs(pts) do
							local ln = o.Corners[i]
							ln.From = p[1]; ln.To = p[2]; ln.Color = ESP.Colors.Box; ln.Visible = true
						end
					else
						for _, l in pairs(o.Corners) do l.Visible = false end
					end
					if ESP.Name then
						o.Name.Text = plr.Name; o.Name.Size = ESP.TextSize; o.Name.Color = ESP.Colors.Name
						o.Name.Position = Vector2.new(x + w/2, y - ESP.TextSize - 2); o.Name.Visible = true
					end
					if ESP.Distance then
						o.Distance.Text = string.format("[%dm]", math.floor(dist)); o.Distance.Size = ESP.TextSize - 2; o.Distance.Color = ESP.Colors.Distance
						o.Distance.Position = Vector2.new(x + w/2, y + h + 2); o.Distance.Visible = true
					end
					if ESP.WeaponText then
						local tool = plr.Character:FindFirstChildOfClass("Tool")
						if tool then
							o.WeaponText.Text = tool.Name; o.WeaponText.Size = ESP.TextSize - 2; o.WeaponText.Color = ESP.Colors.WeaponText
							o.WeaponText.Position = Vector2.new(x + w/2, y + h + (ESP.Distance and ESP.TextSize or 2))
							o.WeaponText.Visible = true
						end
					end
					if ESP.Tracer then
						local origin
						if ESP.TracerOrigin == 1 then origin = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
						elseif ESP.TracerOrigin == 2 then origin = Vector2.new(Camera.ViewportSize.X/2, 0)
						elseif ESP.TracerOrigin == 3 then local m = utility:MouseLocation(); origin = Vector2.new(m.X, m.Y)
						else origin = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2) end
						o.Tracer.From = origin; o.Tracer.To = Vector2.new(x + w/2, y + h)
						o.Tracer.Color = ESP.Colors.Tracer; o.Tracer.Visible = true
					end
					if ESP.HealthBar then
						local hpFrac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
						local bx = x - 6
						o.HealthBarBG.From = Vector2.new(bx, y); o.HealthBarBG.To = Vector2.new(bx, y + h); o.HealthBarBG.Visible = true
						o.HealthBar.From = Vector2.new(bx, y + h * (1 - hpFrac)); o.HealthBar.To = Vector2.new(bx, y + h)
						o.HealthBar.Color = ESP.Colors.HealthBar
						o.HealthBar.Visible = true
						if ESP.HealthText then
							o.HealthText.Text = tostring(math.floor(hum.Health)); o.HealthText.Size = ESP.TextSize - 3
							o.HealthText.Color = ESP.Colors.HealthText
							o.HealthText.Position = Vector2.new(bx - 4, y + h * (1 - hpFrac) - 6)
							o.HealthText.Visible = true
						end
					end
					if ESP.Skeleton then
						local i = 0
						for _, bones in ipairs(SKELETON) do
							i = i + 1
							local a = char:FindFirstChild(bones[1]); local b = char:FindFirstChild(bones[2])
							local line = o.Skeleton[i]
							if a and b then
								local ap, av = Camera:WorldToViewportPoint(a.Position)
								local bp, bv = Camera:WorldToViewportPoint(b.Position)
								if av and bv then
									line.From = Vector2.new(ap.X, ap.Y); line.To = Vector2.new(bp.X, bp.Y); line.Color = ESP.Colors.Skeleton; line.Visible = true
								else line.Visible = false end
							else line.Visible = false end
						end
					else
						for _, l in pairs(o.Skeleton) do l.Visible = false end
					end
					if ESP.Glow then
						if not o.Highlight then
							o.Highlight = Instance.new("Highlight")
							o.Highlight.FillTransparency = 0.6
							o.Highlight.OutlineTransparency = 0
							o.Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
							o.Highlight.Parent = cre
						end
						o.Highlight.Adornee = char
						o.Highlight.FillColor = ESP.Colors.Glow
						o.Highlight.OutlineColor = ESP.Colors.Glow
						o.Highlight.Enabled = true
					elseif o.Highlight then
						o.Highlight.Enabled = false
					end
					ok = true
				until true
				if not ok then hideAll(o) end
			end
		end)
