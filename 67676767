		local function applySky(name)
			local props = SKY_TABLE[name]; if not props then return end
			clearApplied()
			local existing = Lighting:FindFirstChildOfClass("Sky")
			if existing then SKY.SavedOrig = existing:Clone(); existing:Destroy() end
			local sky = Instance.new("Sky")
			for k, v in pairs(props) do sky[k] = v end
			sky.Parent = Lighting
			SKY.Applied = sky
		end
