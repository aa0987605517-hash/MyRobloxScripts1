		local origFogEnd, origFogStart, origFogColor = Lighting.FogEnd, Lighting.FogStart, Lighting.FogColor
		local origAmbient, origOutdoor, origBrightness = Lighting.Ambient, Lighting.OutdoorAmbient, Lighting.Brightness
		local origClockTime = Lighting.ClockTime
		local savedSky = nil
		--
		utility:CreateConnection(RunService.RenderStepped, function()
			-- Fog
			if FX.RemoveFog then
				Lighting.FogEnd = 100000
				Lighting.FogStart = 100000
			else
				Lighting.FogEnd = origFogEnd
				Lighting.FogStart = origFogStart
			end
			-- Skybox
			if FX.RemoveSkybox then
				if not savedSky then
					local existing = Lighting:FindFirstChildOfClass("Sky")
					if existing then savedSky = existing:Clone(); existing:Destroy() end
				end
			else
				if savedSky and not Lighting:FindFirstChildOfClass("Sky") then
					savedSky.Parent = Lighting
					savedSky = nil
				end
			end
			-- Grass
			pcall(function() if workspace.Terrain then workspace.Terrain.Decoration = not FX.RemoveGrass end end)
			-- Brightness
			if FX.Brightness == 3 then -- Full Bright
				Lighting.Ambient = Color3.fromRGB(255,255,255)
				Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
				Lighting.Brightness = 2
				Lighting.ClockTime = 14
			elseif FX.Brightness == 2 then -- Night Mode
				Lighting.Ambient = Color3.fromRGB(20,20,25)
				Lighting.OutdoorAmbient = Color3.fromRGB(30,30,40)
				Lighting.Brightness = 0.5
				Lighting.ClockTime = 0
			else
				Lighting.Ambient = origAmbient
				Lighting.OutdoorAmbient = origOutdoor
				Lighting.Brightness = origBrightness
				Lighting.ClockTime = origClockTime
			end
			-- Post processing
			for _, fx in pairs(Lighting:GetChildren()) do
				if fx:IsA("PostEffect") or fx:IsA("BloomEffect") or fx:IsA("BlurEffect") or fx:IsA("ColorCorrectionEffect") or fx:IsA("DepthOfFieldEffect") or fx:IsA("SunRaysEffect") then
					fx.Enabled = not FX.DisablePP
				end
			end
			-- Force third person
			if FX.ForceTP then
				LP.CameraMode = Enum.CameraMode.Classic
				LP.CameraMinZoomDistance = 10
				LP.CameraMaxZoomDistance = 128
			else
				LP.CameraMinZoomDistance = 0.5
				LP.CameraMaxZoomDistance = 128
			end
			-- Transparent walls / props
			if FX.TWalls > 0 or FX.TProps > 0 then
				local wallsAlpha = 1 - FX.TWalls / 100
				local propsAlpha = 1 - FX.TProps / 100
				for _, d in pairs(workspace:GetDescendants()) do
					if d:IsA("BasePart") and not d.Parent:FindFirstChildOfClass("Humanoid") then
						local target = d.Size.X * d.Size.Y * d.Size.Z > 200 and wallsAlpha or propsAlpha
						if d.Transparency < target then
							d.Transparency = target
						end
					end
				end
			end
			-- Hide teammates
			for _, plr in pairs(Players:GetPlayers()) do
				if plr ~= LP and plr.Character then
					local same = LP.Team and plr.Team == LP.Team
					for _, part in pairs(plr.Character:GetDescendants()) do
						if part:IsA("BasePart") or part:IsA("Decal") then
							if same and FX.HideTeam then
								part.Transparency = 1
							end
						end
					end
				end
			end
		end)
	end
