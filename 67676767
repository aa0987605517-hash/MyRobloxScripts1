								if (cam.CFrame.Position - part.Position).Magnitude <= AIM.MaxDist then
									local vp, onScreen = cam:WorldToViewportPoint(part.Position)
									if onScreen then
										local d = (Vector2.new(vp.X, vp.Y) - mouse).Magnitude
										if d < bestDist and ((not AIM.Visible) or isVisible(char)) then
											bestDist = d; best = part
										end
