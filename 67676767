		local last = nil
		utility:CreateConnection(RunService.Heartbeat, function()
			if SKY.Enabled then
				local name = SKY_ORDER[SKY.Choice]
				if name ~= last then
					applySky(name); last = name
				elseif SKY.Applied and not SKY.Applied.Parent then
					applySky(name)
