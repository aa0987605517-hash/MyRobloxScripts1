		utility:CreateConnection(RunService.RenderStepped, function(dt)
			if not AS.Enabled then
				if sightGui then sightGui.Enabled = false end
				return
			end
			if not sightGui or not sightGui.Parent then buildGui() end
			sightGui.Enabled = true
			timeAcc = timeAcc + dt
			local m = UIS:GetMouseLocation()
			local tpos
			if AS.FollowMouse then
				aimContainer.Position = UDim2.new(0, m.X, 0, m.Y)
				tpos = UDim2.new(0, m.X, 0, m.Y + AS.TextYOffset)
			else
				aimContainer.Position = UDim2.new(0.5, 0, 0.5, 0)
				tpos = UDim2.new(0.5, 0, 0.5, AS.TextYOffset)
			end
			if textLabel then textLabel.Position = tpos end
			for _, g in ipairs(textGlows) do g.Position = tpos end
			smoothedRotation = (smoothedRotation + AS.Rotation*dt) % 360
			aimContainer.Rotation = smoothedRotation
			local lt = AS.Thickness
			local len = -10 + (-30 - -10) * pulseFn(timeAcc, AS.Pulse)
			setBoth(topLine, topGlow,       UDim2.new(0, lt, 0, len),  UDim2.new(0.5, -lt/2, 0, 0))
			setBoth(bottomLine, bottomGlow, UDim2.new(0, lt, 0, len),  UDim2.new(0.5, -lt/2, 1, -len))
			setBoth(leftLine, leftGlow,     UDim2.new(0, len, 0, lt),  UDim2.new(0, 0, 0.5, -lt/2))
			setBoth(rightLine, rightGlow,   UDim2.new(0, len, 0, lt),  UDim2.new(1, -len, 0.5, -lt/2))
			local c = AS.Rainbow and getRainbow(timeAcc) or AS.Color
			for _, f in ipairs({topLine, bottomLine, leftLine, rightLine}) do f.BackgroundColor3 = c end
			if textLabel then textLabel.TextColor3 = c end
			local gOn = AS.Glow > 0
			for _, s in ipairs(glowStrokes) do
				s.Color = c
				s.Transparency = math.clamp(1 - (1-(s:GetAttribute("base") or 0.5))*AS.Glow, 0, 1)
				s.Enabled = gOn
			end
		end)
		LP.CharacterAdded:Connect(function() task.wait(0.2); if AS.Enabled then buildGui() end end)
	end
	-- [[ // Aimbot page 3: Movement (Fly / Noclip / Speed) // ]]
	do
		local Players = game:GetService("Players")
		local UIS = game:GetService("UserInputService")
		local RunService = game:GetService("RunService")
		local LP = Players.LocalPlayer
		--
		local moveSec = aimbot:CreateSection({Name = "Movement", Size = 200, Side = "Left"})
		local MV = { Fly = false, Noclip = false, Speed = 16, Jump = 50, FlySpeed = 60 }
		moveSec:CreateToggle({Name = "Fly", State = false, Callback = function(s) MV.Fly = s end})
		moveSec:CreateToggle({Name = "Noclip", State = false, Callback = function(s) MV.Noclip = s end})
		moveSec:CreateSlider({Name = "Walk Speed", State = 16, Max = 500, Min = 0, Decimals = 1, Suffix = "", Callback = function(v) MV.Speed = v end})
		moveSec:CreateSlider({Name = "Jump Power", State = 50, Max = 500, Min = 0, Decimals = 1, Suffix = "", Callback = function(v) MV.Jump = v end})
		moveSec:CreateSlider({Name = "Fly Speed", State = 60, Max = 500, Min = 5, Decimals = 1, Suffix = "", Callback = function(v) MV.FlySpeed = v end})
		--
		local bv, bg
		local function ensureFly()
			local char = LP.Character; if not char then return end
			local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
			if not bv or bv.Parent ~= hrp then
				if bv then bv:Destroy() end
				bv = Instance.new("BodyVelocity")
				bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
				bv.Velocity = Vector3.new(0, 0, 0)
				bv.Parent = hrp
			end
			if not bg or bg.Parent ~= hrp then
				if bg then bg:Destroy() end
				bg = Instance.new("BodyGyro")
				bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
				bg.P = 9000
				bg.CFrame = hrp.CFrame
				bg.Parent = hrp
			end
		end
		local function killFly()
			if bv then bv:Destroy(); bv = nil end
			if bg then bg:Destroy(); bg = nil end
		end
		--
		utility:CreateConnection(RunService.Heartbeat, function()
			local char = LP.Character; if not char then return end
			local hum = char:FindFirstChildOfClass("Humanoid")
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not (hum and hrp) then return end
			-- Walk / Jump
			pcall(function() hum.WalkSpeed = MV.Speed end)
			pcall(function() hum.JumpPower = MV.Jump; hum.UseJumpPower = true end)
			-- Noclip
			if MV.Noclip then
				for _, p in ipairs(char:GetDescendants()) do
					if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
				end
			end
			-- Fly
			if MV.Fly then
				ensureFly()
				local cam = workspace.CurrentCamera
				local dir = Vector3.new()
				if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
				if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
				if dir.Magnitude > 0 then dir = dir.Unit * MV.FlySpeed else dir = Vector3.new() end
				bv.Velocity = dir
				bg.CFrame = cam.CFrame
			else
				if bv or bg then killFly() end
			end
		end)
		LP.CharacterAdded:Connect(function() killFly() end)
	end
	-- [[ // Configs page: Blocked Players // ]]
	do
		local Players = game:GetService("Players")
		local LP = Players.LocalPlayer
		--
		local blockSec = config:CreateSection({Name = "Blocked Players", Size = 240, Side = "Left"})
		local listSec  = config:CreateSection({Name = "Currently Blocked", Size = 240, Side = "Right"})
		--
		local BLOCK = {}
		_G.PW_BLOCK = BLOCK
		if library and library.__state then library.__state.BLOCK = BLOCK end
		--
		local function listPlayers()
			local names = {"(select)"}
			for _, p in pairs(Players:GetPlayers()) do
				if p ~= LP then names[#names + 1] = p.Name end
			end
			return names
		end
		local function listBlocked()
			local names = {"(none)"}
			for name in pairs(BLOCK) do names[#names + 1] = name end
			return names
		end
		--
		local selectedTarget = 1
		local selectedBlocked = 1
		local pickDrop, blockedDrop
		--
		pickDrop = blockSec:CreateDropdown({Name = "Pick Player", State = 1, Options = listPlayers(), Callback = function(v) selectedTarget = v end})
		--
		local btnAdd, btnRemove, btnClear, btnRefresh
		btnAdd = blockSec:CreateToggle({Name = "Block Selected", State = false, Callback = function(s)
			if s then
				local opts = listPlayers()
				local name = opts[selectedTarget]
				if name and name ~= "(select)" then
					BLOCK[name] = true
				end
				task.wait(0.05); if btnAdd then btnAdd:Set(false) end
			end
		end})
		btnRefresh = blockSec:CreateToggle({Name = "Refresh List", State = false, Callback = function(s)
			if s then
				task.wait(0.05); if btnRefresh then btnRefresh:Set(false) end
			end
		end})
		--
		blockedDrop = listSec:CreateDropdown({Name = "Blocked", State = 1, Options = listBlocked(), Callback = function(v) selectedBlocked = v end})
		btnRemove = listSec:CreateToggle({Name = "Unblock Selected", State = false, Callback = function(s)
			if s then
				local opts = listBlocked()
				local name = opts[selectedBlocked]
				if name and name ~= "(none)" then BLOCK[name] = nil end
				task.wait(0.05); if btnRemove then btnRemove:Set(false) end
			end
		end})
		btnClear = listSec:CreateToggle({Name = "Clear All", State = false, Callback = function(s)
			if s then
				for k in pairs(BLOCK) do BLOCK[k] = nil end
				task.wait(0.05); if btnClear then btnClear:Set(false) end
			end
		end})
	end
end)
